data "aws_ami" "amazon_linux_2023" {
  most_recent = true
  owners      = ["amazon"]
  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }
}

# --- Bootstrap: installs Java, Tomcat 10.1, Nginx, and the systemd
#     service wired to the RDS instance Terraform just created - this
#     replaces README.md Steps 2-4 and 8 by hand. The DB password never
#     touches GitHub or a human; it's generated by random_password.db in
#     rds.tf and flows straight from Terraform state into this file.
#
#     IMPORTANT: this heredoc content is deliberately left-justified at
#     column 0, not indented to match the surrounding HCL. EC2 user_data
#     only executes as a script if "#!" is the literal first two bytes
#     of the file - an indented heredoc does not guarantee that, and any
#     leading whitespace makes cloud-init silently skip the whole script
#     with no error. ---
locals {
  user_data = <<EOF
#!/bin/bash
set -eux

dnf update -y
dnf install -y java-17-amazon-corretto nginx mariadb105

# Load the schema once (idempotent: CREATE ... IF NOT EXISTS)
cat > /tmp/schema.sql <<'SCHEMA'
CREATE DATABASE IF NOT EXISTS ${var.db_name};
USE ${var.db_name};

CREATE TABLE IF NOT EXISTS skillexchangeusers (
    firstname     VARCHAR(50)   NOT NULL,
    lastname      VARCHAR(50),
    username      VARCHAR(50)   PRIMARY KEY,
    password      VARCHAR(100)  NOT NULL,
    email         VARCHAR(100),
    phonenumber   BIGINT,
    skilltoteach  VARCHAR(200),
    skilltolearn  VARCHAR(200),
    rating        INT           DEFAULT 0,
    profilepic    LONGBLOB
);
SCHEMA

for i in $(seq 1 10); do
  mysql -h "${aws_db_instance.main.address}" -P 3306 -u "${var.db_username}" -p"${random_password.db.result}" < /tmp/schema.sql && break
  sleep 10
done
rm -f /tmp/schema.sql

TOMCAT_VERSION=$(curl -s https://dlcdn.apache.org/tomcat/tomcat-10/ | grep -oP 'v10\.1\.[0-9]+' | sed 's/^v//' | sort -V | uniq | tail -1)
if [ -z "$TOMCAT_VERSION" ]; then
  TOMCAT_VERSION=10.1.59
fi
echo "Installing Tomcat $TOMCAT_VERSION"
cd /opt
curl -fO https://dlcdn.apache.org/tomcat/tomcat-10/v$${TOMCAT_VERSION}/bin/apache-tomcat-$${TOMCAT_VERSION}.tar.gz
mkdir -p tomcat10
tar xzf apache-tomcat-$${TOMCAT_VERSION}.tar.gz -C tomcat10 --strip-components=1
rm -f apache-tomcat-$${TOMCAT_VERSION}.tar.gz

useradd -r -M -U -d /opt/tomcat10 -s /bin/false tomcat || true
chown -R tomcat:tomcat /opt/tomcat10
chmod +x /opt/tomcat10/bin/*.sh
rm -rf /opt/tomcat10/webapps/manager /opt/tomcat10/webapps/host-manager \
       /opt/tomcat10/webapps/examples /opt/tomcat10/webapps/docs /opt/tomcat10/webapps/ROOT

cat > /etc/systemd/system/tomcat10.service <<'UNIT'
[Unit]
Description=Apache Tomcat 10
After=network.target

[Service]
Type=forking
User=tomcat
Group=tomcat

Environment=JAVA_HOME=/usr/lib/jvm/java-17-amazon-corretto
Environment=CATALINA_HOME=/opt/tomcat10
Environment=CATALINA_BASE=/opt/tomcat10
Environment=CATALINA_PID=/opt/tomcat10/temp/tomcat.pid
Environment="CATALINA_OPTS=-Xms512M -Xmx1024M -server -XX:+UseParallelGC"

Environment=DB_URL=jdbc:mysql://${aws_db_instance.main.address}:3306/${var.db_name}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
Environment=DB_USER=${var.db_username}
Environment=DB_PASSWORD=${random_password.db.result}

ExecStart=/opt/tomcat10/bin/startup.sh
ExecStop=/opt/tomcat10/bin/shutdown.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now tomcat10

# Deploy script run over SSH (through the bastion) on every future push.
# The CI job scp's the new WAR to /tmp/SkillExchangeProject.war first,
# then runs this via "sudo /opt/deploy.sh" - no S3, no SSM involved.
cat > /opt/deploy.sh <<'DEPLOY'
#!/bin/bash
set -e
WAR_SRC=$${1:-/tmp/SkillExchangeProject.war}
WAR_DEST=/opt/tomcat10/webapps/ROOT.war
BACKUP=/opt/tomcat10/webapps/ROOT.war.bak-$(date +%Y%m%d-%H%M%S)

echo "Stopping Tomcat..."
systemctl stop tomcat10

if [ -f "$WAR_DEST" ]; then
  cp "$WAR_DEST" "$BACKUP"
fi

rm -rf /opt/tomcat10/webapps/ROOT
rm -f "$WAR_DEST"
cp "$WAR_SRC" "$WAR_DEST"
chown tomcat:tomcat "$WAR_DEST"
rm -f "$WAR_SRC"

echo "Starting Tomcat..."
systemctl start tomcat10

for i in $(seq 1 15); do
  sleep 2
  if curl -sf -o /dev/null http://localhost:8080/; then
    echo "App is up."
    exit 0
  fi
done

echo "App did not respond in time. Rolling back..."
systemctl stop tomcat10
rm -f "$WAR_DEST"
if [ -f "$BACKUP" ]; then
  cp "$BACKUP" "$WAR_DEST"
  chown tomcat:tomcat "$WAR_DEST"
fi
systemctl start tomcat10
exit 1
DEPLOY
chmod +x /opt/deploy.sh

cat > /etc/nginx/conf.d/skillexchange.conf <<'NGINX'
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX

systemctl enable --now nginx
nginx -t && systemctl reload nginx
EOF
}

# App server: PRIVATE subnet, no public IP at all. Reachable only via
# the ALB (HTTP) and the bastion (SSH) - see security_groups.tf.
resource "aws_instance" "app" {
  ami                    = data.aws_ami.amazon_linux_2023.id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.private[0].id
  vpc_security_group_ids = [aws_security_group.app.id]
  key_name               = aws_key_pair.deploy.key_name
  user_data              = local.user_data

  # DB must exist and have its endpoint known before the app server
  # boots, since the systemd unit is templated with the RDS address.
  depends_on = [aws_db_instance.main]

  tags = { Name = "${var.project_name}-app" }
}
