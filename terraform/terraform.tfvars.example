# Copy to terraform.tfvars for LOCAL runs only, if you want to override
# any default. terraform.tfvars is git-ignored — nothing sensitive needs
# to go here: the DB password and SSH key pair are both generated
# automatically by Terraform.

aws_region   = "us-east-1"
project_name = "skillexchange"
# db_username      = "admin"          # already the default
# ssh_ingress_cidr = "203.0.113.10/32" # restrict bastion SSH to your IP; defaults to 0.0.0.0/0
